rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidUidList(arr) {
      return arr is list && arr.size() <= 50 && (arr.size() == 0 || arr[0] is string);
    }

    function isValidTeamIdList(arr) {
      return arr is list && arr.size() <= 30 && (arr.size() == 0 || arr[0] is string);
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isSelfAppendUid(newList, oldList) {
      return isValidUidList(newList) &&
             request.auth.uid in newList &&
             newList.hasAll(oldList) &&
             newList.size() <= oldList.size() + 1;
    }

    // 3. Relational Workspace Helpers (NEVER used in allow list!)
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function callerMember(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
    }

    function isWorkspaceHr(workspaceId) {
      return isWorkspaceMember(workspaceId) && callerMember(workspaceId).role == 'HR';
    }

    function isAnyManager(workspaceId) {
      return isWorkspaceMember(workspaceId) && callerMember(workspaceId).role == 'MANAGER';
    }

    function isTeamManager(workspaceId, teamId) {
      return isWorkspaceMember(workspaceId) &&
             callerMember(workspaceId).role == 'MANAGER' &&
             teamId in callerMember(workspaceId).managedTeamIds;
    }

    // 4. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUserWorkspaceIndex(data) {
      return data.keys().hasAll(['uid', 'workspaceId', 'workspaceName', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'workspaceId', 'workspaceName', 'updatedAt']) &&
             isValidId(data.uid) &&
             isValidId(data.workspaceId) &&
             data.workspaceName is string && data.workspaceName.size() >= 2 && data.workspaceName.size() <= 100 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidInviteCode(data) {
      return data.keys().hasAll(['workspaceId', 'workspaceName', 'createdByUid', 'createdAt']) &&
             data.keys().hasOnly(['workspaceId', 'workspaceName', 'createdByUid', 'createdAt']) &&
             isValidId(data.workspaceId) &&
             data.workspaceName is string && data.workspaceName.size() >= 2 && data.workspaceName.size() <= 100 &&
             isValidId(data.createdByUid) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll(['name', 'inviteCode', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'inviteCode', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 12 &&
             data.inviteCode.matches('^[A-Z0-9]+$') &&
             isValidId(data.createdByUid) &&
             isValidUidList(data.memberUids) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['workspaceId', 'name', 'code', 'memberUids', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['workspaceId', 'name', 'code', 'memberUids', 'createdAt', 'updatedAt']) &&
             isValidId(data.workspaceId) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
             data.code is string && data.code.size() >= 2 && data.code.size() <= 16 &&
             isValidUidList(data.memberUids) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMember(data) {
      return data.keys().hasAll([
               'workspaceId', 'uid', 'displayName', 'role', 'teamId', 'teamName',
               'managedTeamIds', 'annualDays', 'sickDays', 'personalDays', 'unpaidUsedDays',
               'annualAllowance', 'sickAllowance', 'personalAllowance',
               'syntheticTestRecord', 'viewerUids', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'workspaceId', 'uid', 'displayName', 'role', 'teamId', 'teamName',
               'managedTeamIds', 'annualDays', 'sickDays', 'personalDays', 'unpaidUsedDays',
               'annualAllowance', 'sickAllowance', 'personalAllowance',
               'syntheticTestRecord', 'viewerUids', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.workspaceId) &&
             isValidId(data.uid) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role in ['EMPLOYEE', 'MANAGER', 'HR'] &&
             isValidId(data.teamId) &&
             data.teamName is string && data.teamName.size() >= 1 && data.teamName.size() <= 80 &&
             isValidTeamIdList(data.managedTeamIds) &&
             data.annualDays is int && data.annualDays >= 0 && data.annualDays <= 365 &&
             data.sickDays is int && data.sickDays >= 0 && data.sickDays <= 365 &&
             data.personalDays is int && data.personalDays >= 0 && data.personalDays <= 365 &&
             data.unpaidUsedDays is int && data.unpaidUsedDays >= 0 && data.unpaidUsedDays <= 365 &&
             data.annualAllowance is int && data.annualAllowance >= 0 && data.annualAllowance <= 365 &&
             data.sickAllowance is int && data.sickAllowance >= 0 && data.sickAllowance <= 365 &&
             data.personalAllowance is int && data.personalAllowance >= 0 && data.personalAllowance <= 365 &&
             data.syntheticTestRecord is bool &&
             isValidUidList(data.viewerUids) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLeaveRequest(data) {
      return data.keys().hasAll([
               'workspaceId', 'employeeUid', 'employeeName', 'teamId', 'teamName',
               'leaveType', 'startDate', 'endDate', 'dayCount', 'reason', 'aiAssisted',
               'status', 'syntheticTestRecord', 'viewerUids', 'submittedAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'workspaceId', 'employeeUid', 'employeeName', 'teamId', 'teamName',
               'leaveType', 'startDate', 'endDate', 'dayCount', 'reason', 'aiAssisted',
               'status', 'syntheticTestRecord', 'viewerUids', 'submittedAt', 'updatedAt',
               'decidedAt', 'decidedByUid', 'decidedByName', 'decisionComment'
             ]) &&
             isValidId(data.workspaceId) &&
             isValidId(data.employeeUid) &&
             data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 100 &&
             isValidId(data.teamId) &&
             data.teamName is string && data.teamName.size() >= 1 && data.teamName.size() <= 80 &&
             data.leaveType in ['ANNUAL', 'SICK', 'PERSONAL', 'UNPAID'] &&
             isValidDateString(data.startDate) &&
             isValidDateString(data.endDate) &&
             data.endDate >= data.startDate &&
             data.dayCount is int && data.dayCount >= 1 && data.dayCount <= 365 &&
             data.reason is string && data.reason.size() <= 500 &&
             data.aiAssisted is bool &&
             data.status in ['PENDING', 'APPROVED', 'DECLINED'] &&
             data.syntheticTestRecord is bool &&
             isValidUidList(data.viewerUids) &&
             isValidTimestamp(data.submittedAt) &&
             isValidTimestamp(data.updatedAt) &&
             (!('decidedAt' in data) || isValidTimestamp(data.decidedAt)) &&
             (!('decidedByUid' in data) || isValidId(data.decidedByUid)) &&
             (!('decidedByName' in data) || (data.decidedByName is string && data.decidedByName.size() >= 1 && data.decidedByName.size() <= 100)) &&
             (!('decisionComment' in data) || (data.decisionComment is string && data.decisionComment.size() <= 500));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
               'workspaceId', 'requestId', 'employeeUid', 'employeeName', 'teamName',
               'action', 'leaveType', 'daysChanged', 'balanceBefore', 'balanceAfter',
               'actorUid', 'actorName', 'actorRole', 'comment', 'syntheticTestRecord',
               'viewerUids', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'workspaceId', 'requestId', 'employeeUid', 'employeeName', 'teamName',
               'action', 'leaveType', 'daysChanged', 'balanceBefore', 'balanceAfter',
               'actorUid', 'actorName', 'actorRole', 'comment', 'syntheticTestRecord',
               'viewerUids', 'createdAt'
             ]) &&
             isValidId(data.workspaceId) &&
             data.requestId is string && data.requestId.size() <= 128 &&
             isValidId(data.employeeUid) &&
             data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 100 &&
             data.teamName is string && data.teamName.size() <= 80 &&
             data.action in ['APPROVED', 'DECLINED', 'BALANCE_ADJUSTED'] &&
             data.leaveType in ['ANNUAL', 'SICK', 'PERSONAL', 'UNPAID'] &&
             data.daysChanged is int && data.daysChanged >= -365 && data.daysChanged <= 365 &&
             data.balanceBefore is int && data.balanceBefore >= 0 && data.balanceBefore <= 365 &&
             data.balanceAfter is int && data.balanceAfter >= 0 && data.balanceAfter <= 365 &&
             isValidId(data.actorUid) &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100 &&
             data.actorRole in ['EMPLOYEE', 'MANAGER', 'HR'] &&
             data.comment is string && data.comment.size() <= 500 &&
             data.syntheticTestRecord is bool &&
             isValidUidList(data.viewerUids) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
               'workspaceId', 'recipientUid', 'requestId', 'title', 'body',
               'outcome', 'actorUid', 'actorName', 'comment', 'read',
               'syntheticTestRecord', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'workspaceId', 'recipientUid', 'requestId', 'title', 'body',
               'outcome', 'actorUid', 'actorName', 'comment', 'read',
               'syntheticTestRecord', 'createdAt', 'readAt'
             ]) &&
             isValidId(data.workspaceId) &&
             isValidId(data.recipientUid) &&
             isValidId(data.requestId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 500 &&
             data.outcome in ['APPROVED', 'DECLINED'] &&
             isValidId(data.actorUid) &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100 &&
             data.comment is string && data.comment.size() <= 500 &&
             data.read is bool &&
             data.syntheticTestRecord is bool &&
             isValidTimestamp(data.createdAt) &&
             (!('readAt' in data) || isValidTimestamp(data.readAt));
    }

    // 5. Collection Security Rules

    match /userWorkspaces/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(uid) &&
                       request.auth.uid == uid &&
                       isValidUserWorkspaceIndex(incoming()) &&
                       incoming().uid == request.auth.uid;
      allow update: if isSignedIn() &&
                       isValidId(uid) &&
                       request.auth.uid == uid &&
                       isValidUserWorkspaceIndex(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['workspaceId', 'workspaceName', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;
    }

    match /inviteCodes/{code} {
      allow get: if isSignedIn() && isValidId(code);
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(code) &&
                       isValidInviteCode(incoming()) &&
                       incoming().createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() &&
                    isValidId(workspaceId) &&
                    (existing().createdByUid == request.auth.uid ||
                     request.auth.uid in existing().memberUids ||
                     isWorkspaceMember(workspaceId));
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(workspaceId) &&
                       isValidWorkspace(incoming()) &&
                       incoming().createdByUid == request.auth.uid &&
                       request.auth.uid in incoming().memberUids;
      allow update: if isSignedIn() &&
                       isValidId(workspaceId) &&
                       isValidWorkspace(incoming()) &&
                       incoming().createdByUid == existing().createdByUid &&
                       incoming().inviteCode == existing().inviteCode &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: HR renames workspace
                         (isWorkspaceHr(workspaceId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])) ||
                         // Action 2: Authenticated joining member appends only self to memberUids
                         (isWorkspaceMember(workspaceId) &&
                          isSelfAppendUid(incoming().memberUids, existing().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
                       );
      allow delete: if false;

      match /teams/{teamId} {
        allow get: if isSignedIn() &&
                      isValidId(workspaceId) &&
                      isValidId(teamId) &&
                      request.auth.uid in existing().memberUids;
        allow list: if isSignedIn() &&
                       request.auth.uid in existing().memberUids;
        allow create: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(teamId) &&
                         isValidTeam(incoming()) &&
                         incoming().workspaceId == workspaceId &&
                         request.auth.uid in incoming().memberUids &&
                         (isWorkspaceHr(workspaceId) ||
                          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdByUid == request.auth.uid);
        allow update: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(teamId) &&
                         isValidTeam(incoming()) &&
                         incoming().workspaceId == existing().workspaceId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action 1: HR updates team details or memberUids
                           (isWorkspaceHr(workspaceId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'memberUids', 'updatedAt'])) ||
                           // Action 2: Newly joined workspace member appends self to team memberUids
                           (isWorkspaceMember(workspaceId) &&
                            isSelfAppendUid(incoming().memberUids, existing().memberUids) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
                         );
        allow delete: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(teamId) &&
                         isWorkspaceHr(workspaceId);
      }

      match /members/{memberId} {
        allow get: if isSignedIn() &&
                      isValidId(workspaceId) &&
                      isValidId(memberId) &&
                      (request.auth.uid == memberId || request.auth.uid in existing().viewerUids);
        allow list: if isSignedIn() &&
                       request.auth.uid in existing().viewerUids;
        allow create: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(memberId) &&
                         isValidMember(incoming()) &&
                         incoming().workspaceId == workspaceId &&
                         incoming().uid == memberId &&
                         (
                           // Action 1: Workspace founder creates own initial HR profile
                           (request.auth.uid == memberId &&
                            incoming().role == 'HR' &&
                            incoming().syntheticTestRecord == false &&
                            request.auth.uid in incoming().viewerUids &&
                            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdByUid == request.auth.uid) ||
                           // Action 2: New member self-joins strictly as EMPLOYEE (no self-escalation)
                           (request.auth.uid == memberId &&
                            incoming().role == 'EMPLOYEE' &&
                            incoming().managedTeamIds.size() == 0 &&
                            incoming().syntheticTestRecord == false &&
                            request.auth.uid in incoming().viewerUids &&
                            exists(/databases/$(database)/documents/workspaces/$(workspaceId))) ||
                           // Action 3: HR creates a colleague profile or synthetic verification test record
                           (isWorkspaceHr(workspaceId) &&
                            request.auth.uid in incoming().viewerUids)
                         );
        allow update: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(memberId) &&
                         isValidMember(incoming()) &&
                         incoming().workspaceId == existing().workspaceId &&
                         incoming().uid == existing().uid &&
                         incoming().syntheticTestRecord == existing().syntheticTestRecord &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action 1: HR manages role, team, managedTeamIds, balances, or viewerUids
                           (isWorkspaceHr(workspaceId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'displayName', 'role', 'teamId', 'teamName', 'managedTeamIds',
                              'annualDays', 'sickDays', 'personalDays', 'unpaidUsedDays',
                              'annualAllowance', 'sickAllowance', 'personalAllowance',
                              'viewerUids', 'updatedAt'
                            ])) ||
                           // Action 2: Authorized team manager deducts balance inside approval transaction
                           (isTeamManager(workspaceId, existing().teamId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'annualDays', 'sickDays', 'personalDays', 'unpaidUsedDays', 'updatedAt'
                            ])) ||
                           // Action 3: Member updates own displayName only (cannot touch role or balances)
                           (request.auth.uid == memberId &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])) ||
                           // Action 4: Workspace member appends self to viewerUids on join
                           (isWorkspaceMember(workspaceId) &&
                            isSelfAppendUid(incoming().viewerUids, existing().viewerUids) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['viewerUids', 'updatedAt']))
                         );
        allow delete: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(memberId) &&
                         existing().syntheticTestRecord == true &&
                         isWorkspaceHr(workspaceId);
      }

      match /leaveRequests/{requestId} {
        allow get: if isSignedIn() &&
                      isValidId(workspaceId) &&
                      isValidId(requestId) &&
                      (existing().employeeUid == request.auth.uid || request.auth.uid in existing().viewerUids);
        allow list: if isSignedIn() &&
                       request.auth.uid in existing().viewerUids;
        allow create: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(requestId) &&
                         isValidLeaveRequest(incoming()) &&
                         incoming().workspaceId == workspaceId &&
                         incoming().status == 'PENDING' &&
                         !('decidedAt' in incoming()) &&
                         !('decidedByUid' in incoming()) &&
                         !('decidedByName' in incoming()) &&
                         !('decisionComment' in incoming()) &&
                         request.auth.uid in incoming().viewerUids &&
                         isWorkspaceMember(workspaceId) &&
                         (
                           (incoming().employeeUid == request.auth.uid && incoming().syntheticTestRecord == false) ||
                           (incoming().syntheticTestRecord == true && isWorkspaceHr(workspaceId))
                         );
        allow update: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(requestId) &&
                         isValidLeaveRequest(incoming()) &&
                         incoming().workspaceId == existing().workspaceId &&
                         incoming().employeeUid == existing().employeeUid &&
                         incoming().teamId == existing().teamId &&
                         incoming().leaveType == existing().leaveType &&
                         incoming().startDate == existing().startDate &&
                         incoming().endDate == existing().endDate &&
                         incoming().dayCount == existing().dayCount &&
                         incoming().syntheticTestRecord == existing().syntheticTestRecord &&
                         incoming().submittedAt == existing().submittedAt &&
                         (
                           // Action 1: Authorized team manager or HR approves/declines a PENDING request (terminal state lock)
                           (existing().status == 'PENDING' &&
                            incoming().status in ['APPROVED', 'DECLINED'] &&
                            incoming().decidedByUid == request.auth.uid &&
                            'decidedAt' in incoming() &&
                            'decidedByName' in incoming() &&
                            (isWorkspaceHr(workspaceId) || isTeamManager(workspaceId, existing().teamId)) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'decidedAt', 'decidedByUid', 'decidedByName', 'decisionComment', 'updatedAt'
                            ])) ||
                           // Action 2: Newly joined member appends self to viewerUids
                           (isWorkspaceMember(workspaceId) &&
                            incoming().status == existing().status &&
                            isSelfAppendUid(incoming().viewerUids, existing().viewerUids) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['viewerUids', 'updatedAt']))
                         );
        allow delete: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(requestId) &&
                         existing().syntheticTestRecord == true &&
                         isWorkspaceHr(workspaceId);
      }

      match /auditLogs/{logId} {
        allow get: if isSignedIn() &&
                      isValidId(workspaceId) &&
                      isValidId(logId) &&
                      request.auth.uid in existing().viewerUids;
        allow list: if isSignedIn() &&
                       request.auth.uid in existing().viewerUids;
        allow create: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(logId) &&
                         isValidAuditLog(incoming()) &&
                         incoming().workspaceId == workspaceId &&
                         incoming().actorUid == request.auth.uid &&
                         request.auth.uid in incoming().viewerUids &&
                         (isWorkspaceHr(workspaceId) || isAnyManager(workspaceId));
        allow update: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(logId) &&
                         isValidAuditLog(incoming()) &&
                         isWorkspaceMember(workspaceId) &&
                         isSelfAppendUid(incoming().viewerUids, existing().viewerUids) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['viewerUids']);
        allow delete: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(logId) &&
                         existing().syntheticTestRecord == true &&
                         isWorkspaceHr(workspaceId);
      }

      match /notifications/{notificationId} {
        allow get: if isSignedIn() &&
                      isValidId(workspaceId) &&
                      isValidId(notificationId) &&
                      (existing().recipientUid == request.auth.uid ||
                       (existing().syntheticTestRecord == true && isWorkspaceHr(workspaceId)));
        allow list: if isSignedIn() &&
                       existing().recipientUid == request.auth.uid;
        allow create: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(notificationId) &&
                         isValidNotification(incoming()) &&
                         incoming().workspaceId == workspaceId &&
                         incoming().actorUid == request.auth.uid &&
                         incoming().read == false &&
                         !('readAt' in incoming()) &&
                         (isWorkspaceHr(workspaceId) || isAnyManager(workspaceId));
        allow update: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(notificationId) &&
                         isValidNotification(incoming()) &&
                         existing().recipientUid == request.auth.uid &&
                         incoming().workspaceId == existing().workspaceId &&
                         incoming().recipientUid == existing().recipientUid &&
                         incoming().requestId == existing().requestId &&
                         incoming().actorUid == existing().actorUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readAt']);
        allow delete: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(notificationId) &&
                         existing().syntheticTestRecord == true &&
                         isWorkspaceHr(workspaceId);
      }
    }
  }
}
